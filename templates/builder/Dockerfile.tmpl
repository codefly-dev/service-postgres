# Compile on the builder's native platform; only the output targets TARGETARCH.
FROM --platform=$BUILDPLATFORM {{ .Bootstrap.Migrate.Toolchain }} AS migrate-builder
ARG TARGETARCH
WORKDIR /src
COPY bootstrap/migrate/go.mod bootstrap/migrate/go.sum ./
# The migration runner builds beside migrate, from the same module graph and
# verified the same way. It is the image's one program, for a managed store
# (Cloud SQL through the connector) and a self-hosted in-cluster one alike.
COPY bootstrap/migrate/cmd ./cmd
RUN set -eu; \
    printf '%s  go.mod\n%s  go.sum\n%s  cmd/managed-bootstrap/main.go\n' '{{ .Bootstrap.Migrate.GoModSHA256 }}' '{{ .Bootstrap.Migrate.GoSumSHA256 }}' '{{ .Bootstrap.Migrate.ManagedBootstrapSHA256 }}' | sha256sum -c -; \
    architecture="${TARGETARCH:-$(go env GOARCH)}"; \
    case "$architecture" in amd64|arm64) ;; *) echo "unsupported target architecture: $architecture" >&2; exit 1 ;; esac; \
    CGO_ENABLED=0 GOOS=linux GOARCH="$architecture" GOTOOLCHAIN=local \
    go build -mod=readonly -trimpath -tags postgres,file \
      -ldflags='-s -w -X main.Version={{ .Bootstrap.Migrate.Version }}' \
      -o /migrate github.com/golang-migrate/migrate/v4/cmd/migrate; \
    CGO_ENABLED=0 GOOS=linux GOARCH="$architecture" GOTOOLCHAIN=local \
    go build -mod=readonly -trimpath -ldflags='-s -w' -o /managed-bootstrap ./cmd/managed-bootstrap
# The runtime contains neither Go nor module manifests: its SBOM describes the
# compiled binary, not the parent's unused module graph.
COPY bootstrap /bootstrap
# COPY of a directory copies its contents, so /tmp travels inside a root
# skeleton to keep its sticky, world-writable mode.
RUN rm -rf /bootstrap/migrate && mkdir -p /scratch-root/tmp && chmod 1777 /scratch-root/tmp

# Nothing but two static binaries and their inputs: no shell, no package
# manager, no package index read at build time, so the image is the same bytes
# whenever it is rendered. The CA bundle is the digest-pinned toolchain's: the
# Cloud SQL connector verifies Google's APIs with it.
FROM scratch

ARG TARGETARCH

# Literals, not build arguments: a label is provenance only if it reports what
# actually built the image, and a --build-arg must not be able to rewrite it.
LABEL {{ range $index, $entry := .Bootstrap.Provenance }}{{ if $index }} \
      {{ end }}{{ $entry.Label }}="{{ $entry.Value }}"{{ end }}

COPY --from=migrate-builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=migrate-builder /scratch-root/ /
COPY --from=migrate-builder /migrate /usr/local/bin/migrate
COPY --from=migrate-builder /managed-bootstrap /usr/local/bin/managed-bootstrap

# Only the staged bootstrap artifact enters the image: the plan, its migration
# sources and self-hosted.json. The build context is the whole service
# directory, which also holds local configuration and secrets, so nothing is
# copied wholesale, and the staged tree carries only files matching the one
# migration-filename definition.
COPY --from=migrate-builder /bootstrap /app/bootstrap

# The Job's own non-root identity; the root filesystem can stay read-only, as
# the runner writes only its staging copy under /tmp.
USER 65534:65534

# The runner verifies the staged sources against plan.json, waits for the
# server, then holds the runtime-access lock across every migration and the
# access reconciliation. A managed Job selects its mode with its binding; an
# in-cluster Job runs this default.
ENTRYPOINT ["/usr/local/bin/managed-bootstrap", "-package", "/app/bootstrap", "-migrate", "/usr/local/bin/migrate"]
