{{- if not .Deployment.Parameters.ExternalInstance }}
apiVersion: v1
kind: Service
metadata:
  name: {{ .Service.Name.DNSCase }}
  namespace: "{{ .Namespace }}"
spec:
  selector:
    app: {{ .Service.Name.DNSCase }}
  ports:
    - name: postgres
      port: 5432
      targetPort: 5432
  # Headless — clients reach postgres via the StatefulSet pod's stable
  # DNS (<svc>-0.<svc>.<ns>.svc).
  clusterIP: None
{{- end }}
